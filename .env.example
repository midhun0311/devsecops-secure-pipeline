# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file to git.

# Secret key used to sign JWT tokens.
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# JWT algorithm (HS256 is fine for demos; use RS256 in production with a key pair)
ALGORITHM=HS256

# How many minutes a token stays valid before the user must log in again
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SQLite database file path (relative to the working directory)
DATABASE_URL=sqlite:///./notes.db
